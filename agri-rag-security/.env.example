# ============================================================
#  API KEYS  —  copy this file to  .env  and paste your keys.
#  This is the ONLY place your keys belong.
# ============================================================

# Groq  -> https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI -> https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter -> https://openrouter.ai/keys
OPENROUTER_API_KEY=


# ------------------------------------------------------------
#  OPTIONAL: LangSmith tracing (leave blank to disable).
#  Get a key at https://smith.langchain.com  (Settings -> API Keys)
# ------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-economics-security
